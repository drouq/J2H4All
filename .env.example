# J2H4All environment — copy to .env for local dev; set these as Render env vars in production.
# All values are secrets unless noted. Never commit a filled-in copy.

# --- App ---
# development | production
APP_ENV=development
# Public base URL of the deployed service (used for OAuth redirect URI). Not secret.
APP_BASE_URL=http://localhost:8000
# Session-cookie signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database ---
# Production is NEON Postgres (blueprint render.neon.yaml sets this from the Neon
# connection string). postgres:// and postgresql:// are both rewritten to the psycopg3
# driver automatically. Local dev without Postgres may use: sqlite:///./j2h4all_dev.sqlite3
DATABASE_URL=

# --- Single-user gate (PRD §3) ---
# The ONE Google account allowed into the web app. Not secret, but treated as config.
ALLOWED_GOOGLE_EMAIL=

# --- Google OAuth (web sign-in + Google Calendar + the monthly Drive backup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar refresh token (scope: calendar.app.created), obtained via the in-app
# "Connect Google Calendar" flow. Local dev stores it in the DB automatically;
# set this in production (Render) so the token survives without a DB dependency.
# Requires: add <APP_BASE_URL>/auth/calendar/callback to the OAuth client's
# authorized redirect URIs, and set the consent screen to "In production" so the
# refresh token doesn't expire after 7 days (Testing-mode limit).
GOOGLE_REFRESH_TOKEN=

# --- Anthropic (required — the coach does not work without it) ---
ANTHROPIC_API_KEY=

# --- Garmin ---
# Base64 garth token blob (garth.client.dumps()), from `python -m app.garmin.login`.
# On Render the live credential is the rotating OAuth2 token in the DB (diauth refresh
# grant); this seeds/re-bootstraps it. See docs/garmin-connectivity-report.md.
GARTH_TOKEN=
# Kill-switch for outbound Garmin syncing (true unless falling back to home sync). Not secret.
GARMIN_SYNC_ENABLED=true
# Approved run sessions become scheduled Garmin structured workouts. Not secret.
# TRUE in production (verified live). Default false so a dev environment can never
# write to the real Garmin account by accident.
GARMIN_WORKOUT_PUSH_ENABLED=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# The ONE chat ID the bot answers. All other senders are silently ignored.
# OPTIONAL since pairing shipped: leave it blank and link the bot from the Setup
# panel instead (get a code, send it to your bot). If set, it ALWAYS WINS and
# disables pairing. Blank AND unpaired means the bot answers nobody at all —
# which is the safe state, not an open door.
TELEGRAM_CHAT_ID=
# Random string passed to setWebhook as secret_token; webhook rejects requests without it.
TELEGRAM_WEBHOOK_SECRET=

# --- LLM model-per-task overrides (PRD §17), optional ---
# JSON object merged over code defaults, e.g. {"morning_brief": "claude-haiku-4-5-20251001"}
MODEL_MAP_JSON=

# --- Proactive-beat times on the user's LOCAL clock (PRD §16/§19), optional ---
# Brief at 10:00 local = after the daily sync lands, so it reads last night's
# recovery. A non-zero minute needs the j2h4all-tick cron denser than hourly.
MORNING_BRIEF_HOUR=10
MORNING_BRIEF_MINUTE=0
# End-of-day debrief (feel check-in + lifestyle log, merged) at 22:00 local.
DAILY_DEBRIEF_HOUR=22
# Sunday 23:00 — after the weekend long runs are done and synced, an hour past the debrief.
WEEKLY_REVIEW_HOUR=23

# --- Dev only: fake signed-in user for local testing. IGNORED unless APP_ENV=development. ---
DEV_AUTH_BYPASS_EMAIL=
